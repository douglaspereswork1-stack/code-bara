# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
prisma/dev.db
prisma/dev.db-journal

# debug scripts (temporários — NÃO commitar)
prisma/check-*.ts
prisma/debug-*.ts
prisma/test-*.ts
prisma/seed-*.ts
!prisma/seed.ts
!prisma/seed-quizzes.ts
!prisma/seed-content.ts
!prisma/seed-exercicios.ts

.vercel
